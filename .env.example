# ==============================================================================
# Flash Sloth Agent — Environment Configuration Example
# Copy this file to .env and configure your environment variables.
# ==============================================================================

# Core Agent Settings
FLASH_APP_NAME="Flash Sloth Agent"
FLASH_DEBUG=false
FLASH_HOST=0.0.0.0
FLASH_PORT=8765
FLASH_STORAGE_BASE_DIR=flash_storage

# Pairing and Security
FLASH_PAIRING_CODE_TTL_SECONDS=300
FLASH_TOKEN_TTL_HOURS=168
FLASH_SAFETY_EMERGENCY_KEY=esc

# Gemma / Ollama Local Inference (Featured Category)
# Runs 100% locally and privately via Ollama on http://localhost:11434
FLASH_OLLAMA_BASE_URL=http://localhost:11434
FLASH_OLLAMA_MODEL=gemma2:2b
FLASH_OLLAMA_TIMEOUT_SECONDS=120.0
FLASH_FAST_PATH_ENABLED=true

# ElevenLabs Speech Synthesis (Optional Cloud Speech)
# If left empty, Flash seamlessly uses 100% offline Windows SAPI speech synthesis.
FLASH_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
FLASH_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Browserbase / Stagehand Browser Automation (Optional Cloud Browser)
# If left empty, Flash uses local headless Playwright Chromium/Edge browser.
FLASH_BROWSERBASE_API_KEY=your_browserbase_api_key_here
FLASH_BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here

# MongoDB Atlas Cloud Storage (Optional Cloud Data Layer)
# If left empty, Flash stores routines and preferences locally in private JSON.
FLASH_MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority
FLASH_MONGODB_DATABASE=flash_agent

# Sentry Telemetry and Error Tracking (Optional Cloud Tracing)
# Includes strict PII scrubbing: strips local filepaths, credentials, and image binaries.
FLASH_SENTRY_DSN=https://example_public_key@o0.ingest.sentry.io/0
FLASH_SENTRY_ENVIRONMENT=development
FLASH_SENTRY_TRACES_SAMPLE_RATE=1.0

# Render Cloud Deployment
FLASH_CLOUD_MODE=coordinator
